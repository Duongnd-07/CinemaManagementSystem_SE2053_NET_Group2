# Local development only. Enable real authentication before any shared deployment.
auth.enabled=false
auth.dev.staffId=1
auth.dev.managerId=1
db.driver=com.microsoft.sqlserver.jdbc.SQLServerDriver
db.url=jdbc:sqlserver://localhost:1433;databaseName=cinemaDB;encrypt=true;trustServerCertificate=true
db.user=YOUR_DB_USER
payment.vnpay.tmn-code=
payment.vnpay.hash-secret=
payment.vnpay.payment-url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
payment.vnpay.return-url=https://YOUR_PUBLIC_HTTPS_HOST/customer/booking/payment/return
payment.vnpay.callback-url=https://YOUR_PUBLIC_HTTPS_HOST/api/v1/commerce/payment/webhook/vnpay
payment.vnpay.expire-minutes=10
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.sender.email=
mail.sender.password=
db.password=CHANGE_ME
