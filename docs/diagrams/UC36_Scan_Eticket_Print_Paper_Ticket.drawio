rtex="1" parent="1"><mxGeometry x="66" y="1278" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd86" value="[Staff clicks &quot;Đã in xong&quot;]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="1610" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd88" value="[A6_Staff clicks &quot;Mở lại hộp thoại in&quot;]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="16" y="2323" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd90" value="[A6_Staff clicks &quot;Chưa in được&quot; (print dialog cancelled, printer failed)]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="16" y="2427" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd92" value="[each ticket of the print job (one transaction)]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1156" y="1850" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd94" value="[E5_printed by another staff member meanwhile, or the ticket changed]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="2018" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd96" value="[A6_Staff leaves the page (e.g. Back) without answering]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="2636" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd98" value="[A2_reprint a lost paper ticket]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="2804" width="600" height="18" as="geometry"/></mxCell><mxCell id="nt219" value="A3: decoded text continues at step 9; without camera permission: &quot;Không truy cập được camera. Vui lòng nhập mã vé.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="412" width="600" height="28" as="geometry"/></mxCell><mxCell id="nt220" value="A4: an exchanged ticket (UC-20) shows its new seat; the new ticket of the booking is printed instead. A5: a counter ticket (UC-19) counts as printed at sale, so only a reprint is possible." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="1056" width="640" height="44" as="geometry"/></mxCell><mxCell id="nt221" value="The browser does not tell the page whether Staff printed or cancelled in the print dialog, so a print is saved only when Staff confirms &quot;Đã in xong&quot; (BR-36-03). Cancelling, closing the dialog or leaving the page saves nothing." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="1542" width="700" height="44" as="geometry"/></mxCell><mxCell id="nt222" value="BR-36-01: look up by ticket code or check code (never by booking ID); any ticket shows the whole booking. BR-36-02: printable only if the booking is Paid, the ticket is Upcoming, its seat is not broken (E9: &quot;Đổi ghế / hoàn tiền&quot; opens UC-20), the showtime is not cancelled, and now is between 24 hours before the start and the end. BR-36-03 / 04: each ticket is printed once, saved only after Staff confirms; reprints need a reason and are logged. BR-36-07: an open shift is required; printing never changes money or ticket status (no check-in)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="3108" width="700" height="116" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d224" name="UC-36 Activity"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1908" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st1" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="545" y="25" width="30" height="30" as="geometry"/></mxCell><mxCell id="a2" value="Open Scan &amp; Print Ticket" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#7EC8F1;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="95" width="260" height="50" as="geometry"/></mxCell><mxCell id="dc3" value="" style="rhombus;html=1;fillColor=#7EC8F1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="40" height="40" as="geometry"/></mxCell><mxCell id="a4" value="Show &quot;Open a Shift First&quot;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#7EC8F1;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="175" width="260" height="50" as="geometry"/></mxCell><mxCell id="en5" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1152" y="