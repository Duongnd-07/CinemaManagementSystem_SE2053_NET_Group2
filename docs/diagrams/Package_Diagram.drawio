system logs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="596" y="224" width="136" height="36" as="geometry"/></mxCell><mxCell id="p13" value="common" style="shape=folder;fontStyle=1;tabWidth=65;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="745" y="198" width="145" height="66" as="geometry"/></mxCell><mxCell id="t14" value="header, sidebar,&lt;br&gt;shared fragments" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="751" y="224" width="136" height="36" as="geometry"/></mxCell><mxCell id="p15" value="tags" style="shape=folder;fontStyle=1;tabWidth=54;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="82" width="260" height="90" as="geometry"/></mxCell><mxCell id="t16" value="JSP tag files: movie-grid, pagination,&lt;br&gt;review-panel, notification-list" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="928" y="110" width="248" height="40" as="geometry"/></mxCell><mxCell id="p17" value="assets" style="shape=folder;fontStyle=1;tabWidth=69;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="188" width="260" height="90" as="geometry"/></mxCell><mxCell id="t18" value="css, images, js (seat map, checkout,&lt;br&gt;room editor, scan &amp; print, system logs...)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="928" y="216" width="248" height="40" as="geometry"/></mxCell><mxCell id="p19" value="«library» Jakarta EE 10" style="shape=folder;fontStyle=1;tabWidth=209;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="300" height="140" as="geometry"/></mxCell><mxCell id="t20" value="jakarta.servlet-api 6, JSP 3.1, JSTL 3&lt;br&gt;(runs on Apache Tomcat 10.1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310" y="104" width="280" height="40" as="geometry"/></mxCell><mxCell id="p21" value="vn.edu.fpt.filter" style="shape=folder;fontStyle=1;tabWidth=161;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="260" height="180" as="geometry"/></mxCell><mxCell id="t22" value="AuthFilter (login, RBAC by URL)&lt;br&gt;EncodingFilter (UTF-8)&lt;br&gt;ErrorLogFilter&lt;br&gt;UnreadNotificationFilter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="384" width="245" height="80" as="geometry"/></mxCell><mxCell id="p23" value="vn.edu.fpt.controller" style="shape=folder;fontStyle=1;tabWidth=193;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="340" width="800" height="180" as="geometry"/></mxCell><mxCell id="p24" value="auth" style="shape=folder;fontStyle=1;tabWidth=51;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="418" y="386" width="116" height="60" as="geometry"/></mxCell><mxCell id="t25" value="6 servlets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="424" y="416" width="104" height="20" as="geometry"/></mxCell><mxCell id="p26" value="customer" style="shape=folder;fontStyle=1;tabWidth=79;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="386" width="116" height="60" as="geometry"/></mxCell><mxCell id="t27" value="18 servlets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="552" y="416" width="104" height="20" as="geometry"/></mxCell><mxCell id="p28" value="staff" style="shape=folder;fontStyle=1;tabWidth=58;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="674" y="386" width="116" height="60" as="geometry"/></mxCell><mxCell id="t29" value="8 servlets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="416" width="104" height="20" as="geometry"/></mxCell><mxCell id="p30" value="manager" style="shape=folder;fontStyle=1;tabWidth=72;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="802" y="386" width="116" height="60" as="geometry"/></mxCell><mxCell id="t31" value="14 servlets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="808" y="416" width="104" height="20" as="geometry"/></mxCell><mxCell id="p32" value="admin" style="shape=folder;fontStyle=1;tabWidth=58;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="386" width="116" height="60" as="geometry"/></mxCell><mxCell id="t33" value="3 servlets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="936" y="416" width="104" height="20" as="geometry"/></mxCell><mxCell id="p34" value="payment" style="shape=folder;fontStyle=1;tabWidth=72;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1058" y="386" width="116" height="60" as="geometry"/></mxCell><mxCell id="t35" value="1 servlet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1064" y="416" width="104" height="20" as="geometry"/></mxCell><mxCell id="t36" value="One @WebServlet per function, grouped by actor (+ NotificationInboxServlet, PosterServlet). Reads the request, checks the CSRF token, calls the service layer, then forwards to a JSP or redirects (Post/Redirect/Get). payment = VnPayWebhookServlet (IPN)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="418" y="458" width="770" height="60" as="geometry"/></mxCell><mxCell id="p37" value="vn.edu.fpt.listener" style="shape=folder;fontStyle=1;tabWidth=177;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="340" width="300" height="180" as="geometry"/></mxCell><mxCell id="t38" value="Background jobs (ServletContextListener):&lt;br&gt;SeatHoldCleanupListener (JOB-01)&lt;br&gt;ShowtimeReminderListener (JOB-02)&lt;br&gt;MovieStatusSyncListener (JOB-03)&lt;br&gt;ShiftAutoCloseListener&lt;br&gt;DBPoolShutdownListener" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310" y="384" width="285" height="110" as="geometry"/></mxCell><mxCell id="p39" value="vn.edu.fpt.service" style="shape=folder;fontStyle=1;tabWidth=169;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="800" height="190" as="geometry"/></mxCell><mxCell id="t40" value="Business rules and transactions across several DAOs (85 classes):&lt;br&gt;• *Service: BookingService, CounterSaleService, ShowtimeService, RoomLayoutService, RoomTemplateService, RoomInspectionService, TicketPrintService, ShiftService, VoucherService, ...&lt;br&gt;• *Form / view objects: MovieForm, CheckoutForm, RoomLayoutForm, SeatMapView, ShiftReport, ...&lt;br&gt;• ActivityLogger (UC-32), ValidationException" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="418" y="662" width="560" height="140" as="geometry"/></mxCell><mxCell id="p41" value="payment" style="shape=folder;fontStyle=1;tabWidth=76;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="664" width="184" height="130" as="geometry"/></mxCell><mxCell id="t42" value="PaymentService&lt;br&gt;PaymentGateway&lt;br&gt;VnPayGateway (signed URL,&lt;br&gt;HMAC-SHA512 check)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1008" y="692" width="172" height="90" as="geometry"/></mxCell><mxCell id="p43" value="vn.edu.fpt.dao" style="shape=folder;fontStyle=1;tabWidth=137;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="870" width="800" height="140" as="geometry"/></mxCell><mxCell id="t44" value="Data access with JDBC PreparedStatement, maps rows to model objects (34 classes):&lt;br&gt;MovieDAO, ShowtimeDAO, BookingDAO, CounterSaleDAO, RoomLayoutDAO, RoomTemplateDAO, RoomInspectionDAO, TicketPrintDAO, ShiftDAO, EquipmentReportDAO, ActivityLogDAO, SystemConfigDAO, UserDAO, VoucherDAO, ..." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="418" y="912" width="770" height="90" as="geometry"/></mxCell><mxCell id="p45" value="vn.edu.fpt.model" style="shape=folder;fontStyle=1;tabWidth=153;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="1070" width="380" height="200" as="geometry"/></mxCell><mxCell id="t46" value="Plain Java objects matching the database tables and status constants (62 classes):&lt;br&gt;Movie, Showtime, Room, Seat, Booking, Ticket, User, Voucher, Shift, EquipmentReport, RoomTemplate, InspectionSlot, PrintTicket, ActivityLog, ...&lt;br&gt;MovieStatus, TicketStatus, SeatType, Role, LogEventType, ..." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="1112" width="362" height="150" as="geometry"/></mxCell><mxCell id="p47" value="vn.edu.fpt.util" style="shape=folder;fontStyle=1;tabWidth=145;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="1070" width="380" height="200" as="geometry"/></mxCell><mxCell id="t48" value="AppConfig (config.properties)&lt;br&gt;DBContext (HikariCP connection pool)&lt;br&gt;EmailService (Jakarta Mail)&lt;br&gt;QrCodeImage (ZXing)&lt;br&gt;CsrfToken, PasswordUtil (PBKDF2)&lt;br&gt;PosterStorage, Messages, Page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="1112" width="362" height="150" as="geometry"/></mxCell><mxCell id="p49" value="«library» Jakarta Mail (Angus)" style="shape=folder;fontStyle=1;tabWidth=247;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="1070" width="300" height="56" as="geometry"/></mxCell><mxCell id="p50" value="«library» ZXing core" style="shape=folder;fontStyle=1;tabWidth=173;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="1142" width="300" height="56" as="geometry"/></mxCell><mxCell id="p51" value="«library» HikariCP + mssql-jdbc" style="shape=folder;fontStyle=1;tabWidth=255;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="1214" width="300" height="56" as="geometry"/></mxCell><mxCell id="t52" value="Emails: OTP, booking confirmation, reminders" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1308" y="1098" width="290" height="20" as="geometry"/></mxCell><mxCell id="t53" value="Ticket QR code images" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1308" y="1170" width="290" height="20" as="geometry"/></mxCell><mxCell id="t54" value="DB connection pool + SQL Server JDBC driver" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1308" y="1242" width="290" height="20" as="geometry"/></mxCell><mxCell id="n55" value="Dependencies point from the user of a package to the package it uses. Calls go one way: controller → service → dao → model.&lt;br&gt;&lt;br&gt;controller, filter, listener, service and dao all use model and util; only the main dependency of each layer is drawn so the diagram stays readable.&lt;br&gt;&lt;br&gt;A few result objects read by dao (CounterOrder, CounterReceipt, ShiftReport, ExchangeRecord, ExchangeTicket) are kept in service. The database (SQL Server cinemaDB) is reached only through dao and util.DBContext." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="320" height="270" as="geometry"/></mxCell><mxCell id="e56" value="«forward»" style="endArrow=open;endSize=12;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;exitX=0.325;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1" source="p23" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e57" value="«use» JSP, JSTL" style="endArrow=open;endSize=12;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;exitX=1;exitY=0.36;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1" source="p1" target="p19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e58" value="«use» Servlet API" style="endArrow=open;endSize=12;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;exitX=1;exitY=0.1778;exitDx=0;exitDy=0;entryX=0;entryY=0.8714;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1" source="p23" target="p19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="372"/><mxPoint x="1250" y="182"/></Array></mxGeometry></mxCell><mxCell id="e59" value="«use»" style="endArrow=open;endSize=12;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1" source="p23" target="p39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e60" value="«use»" style="endArrow=open;endSize=12;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.6053;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1" source="p21" target="p39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="735"/></Array></mxGeometry></mxCell><mxCell id="e61" value="«use»" style="endArrow=open;endSize=12;dashed=1;html=1;edgeStyle=orthogon