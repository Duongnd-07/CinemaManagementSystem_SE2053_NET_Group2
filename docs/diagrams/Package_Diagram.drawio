<mxfile host="app.diagrams.net" type="device"><diagram id="d69" name="Package Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1" value="webapp (JSP views &amp; static resources)" style="shape=folder;fontStyle=1;tabWidth=322;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="800" height="250" as="geometry"/></mxCell><mxCell id="p2" value="views" style="shape=folder;fontStyle=1;tabWidth=61;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="82" width="480" height="196" as="geometry"/></mxCell><mxCell id="p3" value="auth" style="shape=folder;fontStyle=1;tabWidth=51;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="435" y="122" width="145" height="66" as="geometry"/></mxCell><mxCell id="t4" value="login, register,&lt;br&gt;forgot / reset password" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="441" y="148" width="136" height="36" as="geometry"/></mxCell><mxCell id="p5" value="customer" style="shape=folder;fontStyle=1;tabWidth=79;tabHeight=22;tabPosition=left;html=1;whiteSpace=nowrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="5