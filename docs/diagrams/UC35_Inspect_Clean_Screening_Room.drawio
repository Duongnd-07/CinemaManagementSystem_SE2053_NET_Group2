g chiếu&quot;)" style="html=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="2086" as="sourcePoint"/><mxPoint x="2295" y="2086" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m106" value="47 : redirect ?showtimeId (flash)" style="html=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1115" y="2116" as="sourcePoint"/><mxPoint x="465" y="2116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m107" value="48 : show &quot;Đã cập nhật...&quot; | &quot;Đã hoàn tác...&quot; | &quot;Chỉ {staff} mới được sửa...&quot;" style="html=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="2146" as="sourcePoint"/><mxPoint x="105" y="2146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gd10" value="[A1_broken seat / A2_other equipment problem found]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="612" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd12" value="[E1_window not open / E2_required item not ticked / E3_already inspected / E5_cancelled or ended]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="998" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd14" value="[A2_&quot;Other equipment OK&quot; unticked and no equipment report among the new reports]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="1196" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd16" value="[E8_equipment not OK but no equipment report for the room]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="1304" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd18" value="[E3_another staff member saved first (unique ShowtimeID)]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="1532" width="600" height="18" as="geometry"/></mxCell><mxCell id="gd20" value="[A4_the same staff member edits or undoes within 5 minutes]" style="text;html=0;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;autosize=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="66" y="1820" width="600" height="18" as="geometry"/></mxCell><mxCell id="nt108" value="UC-21 Report Equipment Issue: the report locks the seat." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="702" width="330" height="28" as="geometry"/></mxCell><mxCell id="nt109" value="Repeats steps 11 - 17; new reports show &quot;sẽ gắn khi xác nhận&quot; and the number of affected tickets (link to UC-20). Equipment of the room already reported and still Pending / In Progress shows &quot;đã báo trước đó, đang chờ xử lý&quot;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="730" width="700" height="44" as="geometry"/></mxCell><mxCell id="nt110" value="BR-35-02: the window opens when the previous showtime in the room ends (or 30 minutes before the first showtime of the day) and closes at the start time; saving after the start is accepted and flagged &quot;Late&quot; (A3); an ended showtime without inspection is &quot;Missed&quot;. BR-35-03: never blocks ticket sales. BR-35-04: &quot;Seats checked&quot; and &quot;Room cleaned&quot; are required; &quot;Other equipment OK&quot; unticked needs an equipment report (new, or one still Pending / In Progress for the room). BR-35-05: &quot;Has issue&quot; when a report is linked or equipment is not OK. BR-35-06: no open shift needed." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="2170" width="680" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d148" name="UC-35 Sequence - Inspection History"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="816" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ll112" value="Manager" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;labelBackgroundColor=#ffffff;outlineConnect=0;size=40;fontStyle=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="10" width="40" height="766" as="geometry"/></mxCell><mxCell id="ll113" value=":AuthFilter" style="shape=umlLifeline;participant=umlControl;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;labelBackgroundColor=#ffffff;outlineConnect=0;size=40;fontStyle=1;fontFamily