ell><mxCell id="nt234" value="Add Template and Edit open room-editor.jsp in template mode (Template Name and suggested Format instead of Room Name and Status)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1892" width="460" height="44" as="geometry"/></mxCell><mxCell id="nt235" value="BR: templates are stored in RoomTemplate, never in Room, so they never appear in showtimes, sales, seat maps, reports or analytics. Template Name required, &lt;= 50 characters, unique among templates; same grid and seat rules as a room. Creating a room copies the template at that moment, so editing or deleting a template never changes existing rooms. Every change is logged (UC-32)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="1892" width="620" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d292" name="UC-25 Activity"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1458" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st237" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="665" y="25" width="30" height="30" as="geometry"/></mxCell><mxCell id="a238" value="Open Rooms &amp; Seat Layout" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#7EC8F1;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="95" width="260" height="50" as="geometry"/></mxCell><mxCell id="dc239" value="" style="rhombus;html=1;fillColor=#7EC8F1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="180" width="40" height="40" as="geometr